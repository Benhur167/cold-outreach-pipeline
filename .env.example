# ==========================================
# COLD OUTREACH PIPELINE CONFIGURATION
# ==========================================

# ------------------------------------------
# Stage 1: Ocean.io
# ------------------------------------------
OCEAN_API_KEY=your_ocean_api_key_here
OCEAN_API_URL=https://api.ocean.io/v3/search/companies

# ------------------------------------------
# Stage 2: Prospeo
# ------------------------------------------
PROSPEO_API_KEY=your_prospeo_api_key_here
PROSPEO_API_URL=https://api.prospeo.io/search-person

# ------------------------------------------
# Apollo.io (Secondary Company Lookup)
# ------------------------------------------
APOLLO_API_KEY=your_apollo_api_key_here

# ------------------------------------------
# Hunter.io (Fallback Email/Contact Finder)
# ------------------------------------------
HUNTER_API_KEY=your_hunter_api_key_here

# ------------------------------------------
# Stage 3: Eazyreach
# ------------------------------------------
EAZYREACH_API_KEY=your_eazyreach_api_key_here
EAZYREACH_API_URL=https://api.eazyreach.app/api/enrich
# Custom request structure for Eazyreach:
EAZYREACH_HTTP_METHOD=POST
EAZYREACH_AUTH_HEADER=X-API-KEY
EAZYREACH_PAYLOAD_TEMPLATE={"linkedin_url":"<LINKEDIN_URL>"}

# ------------------------------------------
# Stage 4: Brevo (Mailing)
# ------------------------------------------
BREVO_API_KEY=your_brevo_api_key_here
BREVO_SENDER_EMAIL=you@yourdomain.com
BREVO_SENDER_NAME="Your Name"

# ------------------------------------------
# Outreach Email Campaign Settings
# ------------------------------------------
OUTREACH_SUBJECT="Quick question regarding <COMPANY_NAME>"
OUTREACH_TEMPLATE="Hi <FIRST_NAME>,\n\nI noticed you are leading the team at <COMPANY_NAME> as C-level/VP. I'd love to connect and share how we help lookalike companies solve scaling challenges.\n\nBest,\nYour Name"
